RP_DATABASE_URL=sqlite:////app/data/requirements.db
RP_JWT_SECRET=replace-with-at-least-32-random-bytes
RP_OWNER_EMAIL=owner@example.com
RP_ALLOW_REGISTRATION=true
# URL 前缀：留空部署在域名根路径；设为 /issues 则站点位于 https://host/issues/。
# web / api / worker / mcp 共用，修改后需重建 web 容器（docker compose up -d --force-recreate web）。
RP_BASE_PATH=
RP_CORS_ORIGINS=https://feedback.trailsnap.cn
RP_DAILY_SUBMISSION_LIMIT=5
RP_MAX_OPEN_REQUIREMENTS=20
RP_AI_API_URL=
RP_AI_API_KEY=
RP_AI_MODEL=
RP_GITHUB_REPO=LC044/TrailSnap
RP_GITHUB_TOKEN=
RP_GITHUB_APP_ID=
RP_GITHUB_INSTALLATION_ID=
RP_GITHUB_PRIVATE_KEY=
RP_GITHUB_WEBHOOK_SECRET=
RP_GITHUB_OAUTH_CLIENT_ID=
RP_GITHUB_OAUTH_CLIENT_SECRET=
RP_GITHUB_OAUTH_REDIRECT_URI=https://feedback.trailsnap.cn/api/auth/github/callback
RP_WEB_URL=https://feedback.trailsnap.cn
RP_MCP_PUBLIC_URL=https://feedback.trailsnap.cn/mcp/
RP_WORKER_POLL_SECONDS=3
RP_MAX_JOB_ATTEMPTS=5

# 独立仓库：生产 Compose 复用的 external 数据卷（迁移时填原卷名）
RP_DATA_VOLUME=trailsnap-feedback-data
# 自愿邮箱订阅；空 SMTP 时保留队列并退避重试
RP_SMTP_HOST=
RP_SMTP_PORT=587
RP_SMTP_FROM=
RP_SMTP_USERNAME=
RP_SMTP_PASSWORD=
RP_SMTP_TLS=starttls
# 官方 DSH SDK 使用受限 profile；模型连接由 AI 设置管理
RP_DSH_ENABLED=true
RP_DSH_HOME=./data/dsh

# Shared, server-enforced AI limits; daily windows reset at UTC midnight.
RP_AI_ANONYMOUS_DAILY=10
RP_AI_USER_DAILY=30
RP_AI_IP_DAILY=60
RP_AI_GLOBAL_DAILY=200
RP_AI_INTERVAL_SECONDS=20
RP_AI_DAILY_TOKEN_BUDGET=1000000
RP_AI_MAX_OUTPUT_TOKENS=2048
# Shared only by platform callers and the isolated runner; generate a random value.
RP_DSH_RUNNER_TOKEN=
